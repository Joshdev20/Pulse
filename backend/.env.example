# Backend (Render / Railway / Fly.io) — copy to .env or set in the dashboard.

# Required in production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-value

# SQLite is fine locally. In production use a hosted Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./pulse.db

# Origins allowed to call the API. `CORS_ORIGIN_REGEX` additionally matches
# every *.vercel.app origin, which covers preview deployments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+(\.vercel\.app)$

# Populate demo users/posts when the database is empty. Demo deploys only.
AUTO_SEED=false

# Uploads. Point at a mounted volume in production (e.g. /data/uploads).
UPLOAD_DIR=./uploads

# Optional. When unset or unreachable the app uses an in-process cache and a
# single-process realtime hub, which is correct for one instance.
# REDIS_URL=redis://localhost:6379/0
