# Frontend (Vercel) — build-time variables
#
# Absolute API base URL, no trailing slash. Vite inlines this into the bundle at
# build time, so changing it requires a rebuild (not just a restart).
#
# Local dev leaves it empty so Vite proxies /api to 127.0.0.1:8000.
# VITE_API_BASE=http://127.0.0.1:8000
