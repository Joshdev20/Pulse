{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://pulse-api-y16m.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/preview/:path*",
      "destination": "https://pulse-api-y16m.onrender.com/api/preview/:path*"
    },
    {
      "source": "/u/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|duckduckbot|yandex|baiduspider|slurp|whatsapp|facebookexternalhit|facebot|twitterbot|slackbot|linkedinbot|telegrambot|discordbot|applebot|embedly|redditbot|skypeuripreview|pinterest|bitlybot).*"
        }
      ],
      "destination": "https://pulse-api-y16m.onrender.com/api/preview/u/:username"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
